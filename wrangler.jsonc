// Spindl moved to Exploded: a Worker that runs first for every path (worker/index.js: a 301 to the same machine
// there). The static assets stay in the build but are no longer served. Built by `npm run build` into dist/. Deployed by .github/workflows/ci.yml,
// only once PUBLIC_RELEASE is set (README "Deploy"). No public preview URLs.
{
  "name": "spindl",
  "compatibility_date": "2026-09-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": false
}
